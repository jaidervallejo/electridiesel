---
import SectionHeading from '../ui/SectionHeading.astro';
import InfoCard from '../ui/InfoCard.astro';
import { aboutSection, missionVision } from '../../data/content';
---

<section id="nosotros" class="section about" aria-labelledby="about-title">
	<div class="container">
		<SectionHeading
			id="about-title"
			eyebrow={aboutSection.eyebrow}
			title={aboutSection.title}
			description={aboutSection.description}
		/>
		<div class="about__grid">
			{missionVision.map((item) => <InfoCard {...item} variant="feature" />)}
		</div>
	</div>
</section>

<style>
	.about {
		background: var(--color-white);
	}

	.about__grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 1.25rem;
	}

	@media (max-width: 640px) {
		.about__grid {
			grid-template-columns: 1fr;
		}
	}
</style>
