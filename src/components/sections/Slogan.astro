---
import { slogan } from '../../data/content';
---

<section class="slogan on-yellow" aria-label="Nuestro compromiso">
	<div class="container slogan__inner">
		<span class="slogan__bar" aria-hidden="true"></span>
		<p class="slogan__text">
			{slogan.text}{' '}
			<strong>{slogan.highlight}</strong>
		</p>
		<span class="slogan__bar" aria-hidden="true"></span>
	</div>
</section>

<style>
	.slogan {
		background: var(--color-yellow);
		color: var(--color-black);
	}

	.slogan__inner {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 1.5rem;
		padding-block: clamp(1.5rem, 3.5vw, 2.25rem);
	}

	.slogan__bar {
		flex: 0 0 48px;
		height: 4px;
		border-radius: 2px;
		background: var(--color-black);
	}

	.slogan__text {
		font-family: var(--font-display);
		font-size: clamp(1.15rem, 2.4vw, 1.6rem);
		font-weight: 600;
		line-height: 1.3;
		text-align: center;
		max-width: 820px;
	}

	.slogan__text strong {
		font-weight: 800;
	}

	@media (max-width: 560px) {
		.slogan__bar {
			display: none;
		}
	}
</style>
