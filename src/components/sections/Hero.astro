---
import Button from '../ui/Button.astro';
import WhatsAppButton from '../ui/WhatsAppButton.astro';
import SmartImage from '../ui/SmartImage.astro';
import { hero } from '../../data/content';
import { whatsapp } from '../../config/whatsapp';
---

<section id="inicio" class="hero" aria-labelledby="hero-title">
	<div class="hero__media">
		<SmartImage {...hero.image} loading="eager" fetchpriority="high" class="hero__img" />
	</div>
	<div class="container hero__inner">
		<div class="hero__content">
			<h1 id="hero-title" class="hero__title">
				{hero.titleStart}
				<span class="text-highlight">{hero.titleHighlight}</span>
			</h1>
			<p class="hero__desc">{hero.description}</p>
			<div class="hero__actions">
				<Button href={hero.primaryCta.href} iconStart="tag" iconEnd="arrow-right">
					{hero.primaryCta.label}
				</Button>
				<WhatsAppButton label={hero.whatsappCta} message={whatsapp.messages.general} variant="outline" />
			</div>
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		overflow: hidden;
		background: var(--color-black);
		color: var(--color-white);
		isolation: isolate;
	}

	.hero__media {
		position: absolute;
		inset: 0 0 0 38%;
		z-index: -1;
	}

	.hero__media::after {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(90deg, var(--color-black) 0%, rgb(11 12 14 / 0.7) 30%, rgb(11 12 14 / 0) 70%);
	}

	.hero__media :global(.hero__img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
	}

	.hero__inner {
		display: flex;
		align-items: center;
		min-height: clamp(440px, 58vw, 600px);
		padding-block: 4rem;
	}

	.hero__content {
		max-width: 620px;
		display: grid;
		gap: 1.5rem;
	}

	.hero__title {
		font-size: clamp(2rem, 4.6vw, 3.25rem);
		line-height: 1.1;
	}

	.hero__title .text-highlight {
		display: block;
	}

	.hero__desc {
		font-size: clamp(1rem, 1.5vw, 1.15rem);
		color: var(--color-text-inverse);
		max-width: 480px;
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		margin-top: 0.5rem;
	}

	@media (max-width: 760px) {
		.hero__media {
			position: relative;
			inset: auto;
			aspect-ratio: 16 / 10;
		}

		.hero__media::after {
			background: linear-gradient(180deg, rgb(11 12 14 / 0) 55%, var(--color-black) 100%);
		}

		.hero__inner {
			min-height: 0;
			padding-block: 0.5rem 2.5rem;
		}

		.hero__content {
			gap: 1.1rem;
		}

		.hero__actions {
			flex-direction: column;
		}

		.hero__actions :global(.btn) {
			width: 100%;
		}
	}
</style>
