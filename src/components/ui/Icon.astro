---
import type { HTMLAttributes } from 'astro/types';
import { icons, type IconName } from './icons';

interface Props extends Omit<HTMLAttributes<'svg'>, 'class' | 'name'> {
	name: IconName;
	size?: number;
	/** Texto accesible. Si se omite, el ícono es decorativo (aria-hidden). */
	label?: string;
	class?: string;
	strokeWidth?: number;
}

const { name, size = 24, label, class: className, strokeWidth = 1.75, ...rest } = Astro.props;
const a11y = label
	? { role: 'img' as const, 'aria-label': label }
	: { 'aria-hidden': 'true' as const, focusable: 'false' as const };
---

<svg
	class:list={['icon', className]}
	width={size}
	height={size}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width={strokeWidth}
	stroke-linecap="round"
	stroke-linejoin="round"
	{...rest}
	{...a11y}
	set:html={icons[name]}
/>

<style>
	.icon {
		flex-shrink: 0;
		display: inline-block;
		vertical-align: middle;
	}
</style>
